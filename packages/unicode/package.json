{
  "name": "@lankadev/unicode",
  "version": "0.0.0",
  "description": "Script detection, normalization and grapheme-aware text helpers for Sinhala and Tamil Unicode text.",
  "license": "MIT",
  "keywords": [
    "sinhala",
    "tamil",
    "unicode",
    "normalization",
    "grapheme",
    "script-detection",
    "segmenter"
  ],
  "homepage": "https://github.com/dinithrathnayaka23/LankaDev#readme",
  "bugs": {
    "url": "https://github.com/dinithrathnayaka23/LankaDev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinithrathnayaka23/LankaDev.git",
    "directory": "packages/unicode"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "clean": "node -e \"for (const d of ['dist','coverage','.turbo']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "26.6.6"
  }
}
