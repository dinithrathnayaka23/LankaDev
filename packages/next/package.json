{
  "name": "@lankadev/next",
  "version": "0.0.0",
  "description": "Next.js App Router helpers for Sinhala, Tamil and English apps: server locale detection and a client provider.",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "next",
    "app-router",
    "react",
    "sinhala",
    "tamil",
    "sri-lanka",
    "i18n"
  ],
  "homepage": "https://github.com/dinithrathnayaka23/LankaDev#readme",
  "bugs": {
    "url": "https://github.com/dinithrathnayaka23/LankaDev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinithrathnayaka23/LankaDev.git",
    "directory": "packages/next"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "clean": "node -e \"for (const d of ['dist','coverage','.turbo']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@lankadev/core": "workspace:^",
    "@lankadev/react": "workspace:^"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
