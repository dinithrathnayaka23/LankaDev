{
  "name": "@lankadev/core",
  "version": "0.0.0",
  "description": "Locale configuration, fallback and LKR/number/date formatting for Sinhala, Tamil and English (Sri Lanka).",
  "license": "MIT",
  "keywords": [
    "sinhala",
    "tamil",
    "sri-lanka",
    "si-LK",
    "ta-LK",
    "en-LK",
    "i18n",
    "locale",
    "lkr",
    "intl"
  ],
  "homepage": "https://github.com/dinithrathnayaka23/LankaDev#readme",
  "bugs": {
    "url": "https://github.com/dinithrathnayaka23/LankaDev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinithrathnayaka23/LankaDev.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./formatting": {
      "import": {
        "types": "./dist/formatting.d.ts",
        "default": "./dist/formatting.js"
      },
      "require": {
        "types": "./dist/formatting.d.cts",
        "default": "./dist/formatting.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "clean": "node -e \"for (const d of ['dist','coverage','.turbo']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  }
}
