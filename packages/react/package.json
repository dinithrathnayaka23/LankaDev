{
  "name": "@lankadev/react",
  "version": "0.0.0",
  "description": "React provider, hooks, language switcher and transliteration input for Sinhala, Tamil and English apps.",
  "license": "MIT",
  "keywords": [
    "react",
    "sinhala",
    "tamil",
    "sri-lanka",
    "i18n",
    "hooks",
    "transliteration",
    "input"
  ],
  "homepage": "https://github.com/dinithrathnayaka23/LankaDev#readme",
  "bugs": {
    "url": "https://github.com/dinithrathnayaka23/LankaDev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinithrathnayaka23/LankaDev.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "clean": "node -e \"for (const d of ['dist','coverage','.turbo']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@lankadev/core": "workspace:^",
    "@lankadev/transliteration": "workspace:^",
    "@lankadev/unicode": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
